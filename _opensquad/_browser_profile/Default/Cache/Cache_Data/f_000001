    --gold-light: #FDE68A;
    --emerald: #10B981;
    --rose: #F43F5E;
    --text-main: #F8FAFC;
    --text-muted: #94A3B8;
  }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  .resp-md { white-space: normal; }
  .resp-md h2, .resp-md h3, .resp-md h4 { margin: 12px 0 6px; font-size: 1rem; }
  .resp-md ul { margin: 6px 0 6px 18px; }
  .resp-md blockquote { margin: 8px 0; padding: 6px 10px; border-left: 3px solid #64748b; color: #cbd5e1; }
  .resp-md code { background: #1e293b; padding: 1px 4px; border-radius: 4px; }
  svg.viz { max-width: 820px; display: block; }
  .viz-bar { fill: #3987e5; }
  .viz-rot { fill: #cbd5e1; font-size: 11px; }
  .viz-val { fill: #94a3b8; font-size: 11px; }
  .viz-eixo { stroke: #334155; stroke-width: 1; }
  .viz-nota { color: #94a3b8; font-size: 12px; }
  body {
    font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    background: var(--bg-dark);
    background-image: radial-gradient(at 10% 10%, rgba(56, 189, 248, 0.07) 0px, transparent 50%),
                      radial-gradient(at 90% 90%, rgba(129, 140, 248, 0.07) 0px, transparent 50%);
    color: var(--text-main);
    padding: 32px 24px;
    min-height: 100vh;
  }
  .container { max-width: 1240px; margin: 0 auto; }
  
  /* Header com Mascote 3D */
  .header {
    display: flex;
    align-items: center;
    gap: 20px;
    background: var(--bg-card);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid var(--border);
    border-radius: 20px;
    padding: 20px 24px;
    margin-bottom: 24px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4);
  }
  .mascot-wrapper {
    position: relative;
    width: 84px;
    height: 84px;
    flex-shrink: 0;
  }
  .mascot-img {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
    border: 3px solid var(--gold);
    box-shadow: 0 0 20px rgba(245, 158, 11, 0.35);
  }
  .mascot-placeholder {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    background: #1e293b;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 36px;
    border: 3px solid var(--gold);
  }
  .header-info h1 {
    font-size: 24px;
    font-weight: 800;
    letter-spacing: -0.5px;
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .header-info h1 .badge-3d {
    font-size: 11px;
    background: linear-gradient(135deg, var(--accent-blue), var(--accent-indigo));
    color: #070B14;
    padding: 3px 9px;
    border-radius: 20px;
    font-weight: 800;
  }
  .header-info p {
    color: var(--text-muted);
    font-size: 13px;
    margin-top: 4px;
  }

  /* KPIs Cards */
  .kpis {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 16px;
    margin-bottom: 24px;
  }
  .kpi {
    background: var(--bg-card);
    backdrop-filter: blur(12px);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 20px;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }
  .kpi:hover {
    transform: translateY(-2px);
    border-color: var(--border-accent);
  }
  .kpi .l {
    font-size: 12px;
    font-weight: 600;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-bottom: 6px;
  }
  .kpi .v {
    font-size: 28px;
    font-weight: 800;
    color: var(--text-main);
    background: linear-gradient(135deg, #FFFFFF, var(--accent-blue));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  /* Cards */
  .card {
    background: var(--bg-card);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid var(--border);
    border-radius: 18px;
    padding: 22px 24px;
    margin-bottom: 24px;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.3);
  }
  .card h2 {
    font-size: 16px;
    font-weight: 700;
    color: var(--text-main);
    margin-bottom: 14px;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .grid2 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
  }

  .resp {
    white-space: pre-wrap;
    line-height: 1.6;
    font-size: 14px;
    color: #E2E8F0;
  }

  pre.sql {
    background: #0B132B;
    border: 1px solid var(--border);
    padding: 14px 16px;
    border-radius: 12px;
    overflow: auto;
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    color: #A5F3FC;
    line-height: 1.5;
  }

  .search-box {
    width: 100%;
    padding: 12px 18px;
    margin-bottom: 16px;
    background: #0B132B;
    border: 1px solid var(--border);
    border-radius: 12px;
    color: var(--text-main);
    font-size: 14px;
    font-family: inherit;
    transition: border-color 0.2s ease;
  }
  .search-box:focus {
    outline: none;
    border-color: var(--accent-blue);
  }

  .tbl {
    width: 100%;
    border-collapse: collapse;
    font-size: 13px;
  }
  .tbl th {
    background: rgba(30, 41, 59, 0.9);
    color: var(--text-main);
    text-align: left;
    padding: 10px 14px;
    font-weight: 600;
    border-bottom: 1px solid var(--border);
  }
  .tbl td {
    padding: 9px 14px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.04);
    color: #CBD5E1;
  }
  .tbl tr:hover td {
    background: rgba(56, 189, 248, 0.05);
    color: #FFFFFF;
  }

  .btn {
    background: linear-gradient(135deg, var(--accent-blue), #2563EB);
    color: #FFFFFF;
    font-weight: 700;
    border: none;
    padding: 8px 16px;
    border-radius: 8px;
    cursor: pointer;
    font-size: 12px;
    font-family: inherit;
    margin-top: 10px;
    transition: opacity 0.2s ease;
  }
  .btn:hover { opacity: 0.9; }

  .footer-sub {
    color: var(--text-muted);
    font-size: 12px;
    text-align: center;
    margin-top: 24px;
  }

  @media (max-width: 800px) {
    .grid2 { grid-template-columns: 1fr; }
    .header { flex-direction: column; text-align: center; }
    .header-info h1 { justify-content: center; }
  }
</style>
<script>
