    const query = document.getElementById('search').value.toLowerCase();
    const rows = document.querySelectorAll('#resultTable tbody tr');
    rows.forEach(r => {
      r.style.display = r.innerText.toLowerCase().includes(query) ? '' : 'none';
    });
  }
  function copySQL() {
    const sql = document.getElementById('sqlCode').innerText;
    navigator.clipboard.writeText(sql).then(() => {
      const btn = document.getElementById('btnCopySQL');
      btn.innerText = '✔ SQL Copiado!';
      setTimeout(() => btn.innerText = 'Copiar SQL', 2000);
    });
  }
</script>
